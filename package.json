{
  "name": "dsh-roam-planner",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Trip planning workspace for DeepSeek Harness: map panel, itinerary store and Roam tools.",
  "license": "MIT",
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.bundle.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "server",
    "!server/__tests__",
    "client/src/geo.js",
    "client.bundle.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "PROVENANCE.md"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "maplibre-gl": "^5.24.0",
    "typescript": "5.8.3",
    "@types/node": "^22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntonyLang/dsh-roam-planner.git"
  },
  "homepage": "https://github.com/AntonyLang/dsh-roam-planner#readme",
  "bugs": {
    "url": "https://github.com/AntonyLang/dsh-roam-planner/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "travel",
    "trip-planner",
    "map",
    "mcp"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}

